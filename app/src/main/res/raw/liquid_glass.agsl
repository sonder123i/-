// V4.0 Tier 1 · 圆角 SDF 边缘压缩折射 + 微量色散 + 菲涅尔高光
// 由 LiquidGlassContainer 在 API 33+ 通过 RuntimeShader 加载。
// 入参 content 为同一帧共享背景采样（BitmapShader），坐标与本 View 局部坐标一致。

uniform shader content;
uniform float2 uSize;
uniform float uRadius;
uniform float uBevel;
uniform float uRefract;
uniform float uDispersion;
uniform float2 uHighlight;
uniform float uRimIntensity;
uniform half4 uTint;

float sdRoundRect(float2 p, float2 halfSize, float r) {
    float2 q = abs(p) - halfSize + float2(r, r);
    return min(max(q.x, q.y), 0.0) + length(max(q, float2(0.0, 0.0))) - r;
}

half4 main(float2 coord) {
    float2 halfSize = uSize * 0.5;
    float2 p = coord - halfSize;
    float d = sdRoundRect(p, halfSize, uRadius);

    // SDF 梯度即向外法线
    float2 grad = float2(
        sdRoundRect(p + float2(1.0, 0.0), halfSize, uRadius) - d,
        sdRoundRect(p + float2(0.0, 1.0), halfSize, uRadius) - d
    );
    grad = normalize(grad + float2(0.0001, 0.0001));

    float inside = -d;
    float bevel = max(uBevel, 1.0);
    // 0 -> 玻璃中心, 1 -> 边缘菲涅尔带
    float edge = 1.0 - smoothstep(0.0, bevel, inside);

    // 边缘压缩：采样点向圆心偏移，形成透镜内收
    float2 offset = -grad * (edge * edge) * bevel * uRefract;

    // RGB 分通道微偏移，制造真实玻璃边缘色散
    half4 c;
    c.r = content.eval(coord + offset - grad * uDispersion).r;
    c.g = content.eval(coord + offset).g;
    c.b = content.eval(coord + offset + grad * uDispersion).b;
    c.a = content.eval(coord + offset).a;

    // 菲涅尔：随陀螺仪轻微移动的光源方向（加微量偏移避免零向量 NaN）
    float2 lightDir = normalize(float2(-0.5 + uHighlight.x, -0.9 + uHighlight.y) + float2(0.0001, 0.0001));
    float lit = clamp(dot(-grad, lightDir), 0.0, 1.0);
    float rim = pow(edge, 2.2) * lit * uRimIntensity * 0.85;

    c.rgb = mix(c.rgb, uTint.rgb, uTint.a);
    c.rgb += half3(half(rim), half(rim), half(rim));
    c.a = max(c.a, half(uTint.a * 0.92));

    // 形状外完全透明 + 1px 抗锯齿
    float aa = 1.0 - smoothstep(-1.0, 0.0, d);
    c.a *= half(aa);
    return c;
}
