<?xml version="1.0" encoding="utf-8"?>
<!--
    V4.0 光纤主按钮 · 冰川棱镜（浅色）：顶亮底深的光纤渐变，
    白色文字在渐变主体（钴青段）上保持高对比度。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#9BE3EC"
        android:centerColor="#38B4C9"
        android:endColor="#007A94" />
    <corners android:radius="12dp" />
</shape>