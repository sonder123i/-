<?xml version="1.0" encoding="utf-8"?>
<!--
    V5.2 visionOS 深空黑曜石迷你药丸：
    #EB141416 磨砂基底 + 1dp 银白细边 + 顶部冰青一线高光。
    宽度由内容决定（wrap_content），确保 0.12/3.12km · 6'49" 完整显示。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F01D1C1F"
                android:endColor="@color/dr_overlay_surface" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/dr_overlay_rim_silver" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="1dp"
        android:left="24dp"
        android:right="24dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dr_overlay_rim_ice" />
        </shape>
    </item>
</layer-list>
