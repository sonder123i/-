<?xml version="1.0" encoding="utf-8"?>
<!--
    V5.2 展开态控制岛：深空黑曜石磨砂玻璃 + 1dp 银白/冰青高光细边。
    与迷你药丸同材质，展开时药丸隐藏，只保留这块玻璃岛。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F51E1D20"
                android:endColor="@color/dr_overlay_surface_solid" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/dr_overlay_rim_silver" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="1dp"
        android:left="28dp"
        android:right="28dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dr_overlay_rim_ice" />
        </shape>
    </item>
</layer-list>
