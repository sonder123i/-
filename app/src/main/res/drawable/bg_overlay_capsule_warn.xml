<?xml version="1.0" encoding="utf-8"?>
<!-- 步数告警态：黑曜石底 + 冰青细边，提示放入口袋 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dr_overlay_surface_warn" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/dr_overlay_rim_ice" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
