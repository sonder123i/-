<?xml version="1.0" encoding="utf-8"?>
<!--
    V5.2 L2 液态玻璃面板（建圈器上下控制面板）。
    对角受光渐变 + 1.5dp 银白镜面描边，与模式栏透镜 / GPX / ✕ 保持一致，
    92% 以上遮蔽度防止地图路名穿透。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/dr_l2_glass_top"
                android:endColor="@color/dr_l2_glass_bottom" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="@color/dr_silver_rim" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
