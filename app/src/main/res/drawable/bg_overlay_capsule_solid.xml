<?xml version="1.0" encoding="utf-8"?>
<!-- 跨窗模糊被系统禁用时的药丸兜底：更实的高密度黑曜石，杜绝透字 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dr_overlay_surface_solid" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/dr_overlay_rim_silver" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
