<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pf_canvas">

    <com.baidu.mapapi.map.TextureMapView
        android:id="@+id/editMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.zcshou.gogogo.run.ui.editor.OpticalReticleView
        android:id="@+id/opticalReticle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:id="@+id/mapLockBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_map_lock_border"
        android:visibility="gone" />

    <!-- 顶部 36dp 渐隐保护层 -->
    <View
        android:id="@+id/editorTopScrim"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_scrim" />

    <TextView
        android:id="@+id/freehandLockChip"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="14dp"
        android:layout_marginTop="205dp"
        android:background="@drawable/bg_capsule"
        android:drawableStart="@drawable/ic_pencil"
        android:drawablePadding="6dp"
        android:drawableTint="@color/pf_volt"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="地图已锁定 · 单指画线"
        android:textColor="@color/pf_volt"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layerSwitcher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="210dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_capsule"
        android:orientation="vertical"
        android:padding="3dp">

        <TextView
            android:id="@+id/layerDark"
            android:layout_width="46dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_tab_selected"
            android:gravity="center"
            android:text="暗夜"
            android:textColor="@color/pf_volt"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/layerNormal"
            android:layout_width="46dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="标准"
            android:textColor="@color/pf_text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/layerSat"
            android:layout_width="46dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="卫星"
            android:textColor="@color/pf_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnLocateMe"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="240dp"
        android:background="@drawable/bg_round_dark"
        android:contentDescription="定位到我当前位置"
        android:padding="13dp"
        android:src="@drawable/ic_crosshair"
        app:tint="@color/pf_text_primary" />

    <com.zcshou.gogogo.run.ui.glass.CausticGlassView
        android:id="@+id/editorTopPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="10dp"
        android:elevation="8dp"
        app:adaptiveLensScale="true"
        app:backdropSourceId="@id/editMapView"
        app:bevelWidth="14dp"
        app:cornerRadius="24dp"
        app:dispersionStrength="0.10"
        app:glassMaterial="regular"
        app:glassTint="@color/dr_editor_optical_tint"
        app:refractionFalloff="2"
        app:refractionHeight="8dp"
        app:sensorHighlight="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:hint="搜索操场 / 公园，一键飞跃"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/pf_text_primary"
                android:textColorHint="@color/pf_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="搜索"
                android:textColor="@color/pf_on_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_glass_control"
                android:contentDescription="关闭"
                android:padding="11dp"
                android:src="@drawable/ic_xmark"
                app:tint="@color/pf_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchHistoryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/modeTabHost"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:id="@+id/modeTabs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/modePreset"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/ic_stadium"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/pf_text_secondary"
                    android:gravity="center"
                    android:text="操场套模"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/modeTrack"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/ic_location_line"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/pf_text_secondary"
                    android:gravity="center"
                    android:text="逐点连线"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/modeFree"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/ic_pencil"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/pf_text_secondary"
                    android:gravity="center"
                    android:text="自由手绘"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnGpx"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_glass_control"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="GPX"
                    android:textColor="@color/pf_volt"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/modeGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="拖动地图对准操场中心，选尺寸后锁定微调"
            android:textColor="@color/pf_text_secondary"
            android:textSize="11sp" />

        <HorizontalScrollView
            android:id="@+id/panelPreset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/preset400"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_tab_selected"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="400m 田径场"
                    android:textColor="@color/pf_volt"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/preset300"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_secondary_button"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="300m 操场"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/preset200"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_secondary_button"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="200m 迷你场"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/presetRect"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_secondary_button"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="圆角矩形"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/presetEight"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_secondary_button"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="8 字跑道"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/panelSnap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Switch
                android:id="@+id/switchSnap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="路网吸附"
                android:textColor="@color/pf_text_primary"
                android:textSize="12sp"
        android:thumbTint="@color/pf_on_primary" />

            <TextView
                android:id="@+id/snapHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="自动贴合真实步道 / 公路"
                android:textColor="@color/pf_text_secondary"
                android:textSize="11sp" />

            <Switch
                android:id="@+id/switchClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="首尾闭合"
                android:textColor="@color/pf_text_primary"
                android:textSize="12sp"
        android:thumbTint="@color/pf_on_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/gpxInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="支持 trkpt / rtept，WGS-84"
            android:textColor="@color/pf_text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />
        </LinearLayout>
    </com.zcshou.gogogo.run.ui.glass.CausticGlassView>

    <com.zcshou.gogogo.run.ui.glass.CausticGlassView
        android:id="@+id/editorBottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:elevation="8dp"
        app:adaptiveLensScale="true"
        app:backdropSourceId="@id/editMapView"
        app:bevelWidth="14dp"
        app:cornerRadius="24dp"
        app:dispersionStrength="0.10"
        app:glassMaterial="regular"
        app:glassTint="@color/dr_editor_optical_tint"
        app:refractionFalloff="2"
        app:refractionHeight="8dp"
        app:sensorHighlight="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

        <LinearLayout
            android:id="@+id/dockHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lapMetersText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="单圈 --m"
                android:textColor="@color/pf_text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/editorStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.85"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:maxLines="2"
                android:text="拖动地图对准操场"
                android:textColor="@color/pf_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelPresetAlign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/presetAlignSeekRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="周长"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="11sp" />

                <com.zcshou.gogogo.run.ui.widget.VernierSeekBar
                    android:id="@+id/lapSeekAlign"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="300"
                    android:progress="200" />

                <TextView
                    android:id="@+id/lapValueAlign"
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:text="400m"
                    android:textColor="@color/pf_cyan"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.zcshou.gogogo.run.ui.widget.SpecularButton
                android:id="@+id/btnLock"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="2dp"
                android:text="锁定当前跑道并微调"
                android:textSize="14sp"
                app:icon="@drawable/ic_lock_line"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />
        </LinearLayout>

        <com.zcshou.gogogo.run.ui.glass.LiquidGlassContainer
            android:id="@+id/panelPresetLocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:lgBevelWidth="6dp"
            app:lgCaustics="true"
            app:lgCornerRadius="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="微调 1m"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/dpLeft"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_secondary_button"
                    android:contentDescription="微调"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_left_line"
                    app:tint="@color/pf_text_primary" />

                <ImageView
                    android:id="@+id/dpUp"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_secondary_button"
                    android:contentDescription="微调"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_up_line"
                    app:tint="@color/pf_text_primary" />

                <ImageView
                    android:id="@+id/dpDown"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_secondary_button"
                    android:contentDescription="微调"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_down_line"
                    app:tint="@color/pf_text_primary" />

                <ImageView
                    android:id="@+id/dpRight"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_secondary_button"
                    android:contentDescription="微调"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_right_line"
                    app:tint="@color/pf_text_primary" />

                <TextView
                    android:id="@+id/btnUnlock"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary_button"
                    android:drawableStart="@drawable/ic_crosshair"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/pf_text_primary"
                    android:gravity="center"
                    android:text="重新对准"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAngle0"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_secondary_button"
                    android:gravity="center"
                    android:text="0°"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnAngle90"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_secondary_button"
                    android:gravity="center"
                    android:text="90°"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="10sp" />

                <com.zcshou.gogogo.run.ui.widget.VernierSeekBar
                    android:id="@+id/rotateSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="90"
                    android:progress="45" />

                <TextView
                    android:id="@+id/rotateValue"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:text="0°"
                    android:textColor="@color/pf_cyan"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="周长"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="11sp" />

                <com.zcshou.gogogo.run.ui.widget.VernierSeekBar
                    android:id="@+id/lapSeekLock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="300"
                    android:progress="200" />

                <TextView
                    android:id="@+id/lapValueLock"
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:text="400m"
                    android:textColor="@color/pf_cyan"
                    android:textSize="11sp" />
            </LinearLayout>
            </LinearLayout>
        </com.zcshou.gogogo.run.ui.glass.LiquidGlassContainer>

        <LinearLayout
            android:id="@+id/dockActionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUndo"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="撤销"
                android:textSize="12sp"
                app:icon="@drawable/ic_arrow_left_line"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <TextView
                android:id="@+id/btnReverse"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:gravity="center"
                android:text="反转方向"
                android:textColor="@color/pf_text_primary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="清空"
                android:textSize="12sp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dockSaveRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.zcshou.gogogo.run.ui.widget.SpecularButton
                android:id="@+id/btnSave"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="44dp"
