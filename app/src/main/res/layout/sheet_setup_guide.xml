<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pf_card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="22dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/pf_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="30 秒完成基础配置"
            android:textColor="@color/pf_volt"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnGuideClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_round_dark"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/pf_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="只需开启 2 项能力，冷启动不会主动弹任何系统权限框"
        android:textColor="@color/pf_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_capsule"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/guideOverlayDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="@color/pf_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="1 · 悬浮控制胶囊"
                android:textColor="@color/pf_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/guideOverlayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未开启"
                android:textColor="@color/pf_amber"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/guideOverlayAction"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_tab_selected"
            android:gravity="center"
            android:text="一键前往授权"
            android:textColor="@color/pf_volt"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_capsule"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/guideMockDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="@color/pf_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="2 · 选择模拟位置应用"
                android:textColor="@color/pf_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/guideMockStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未选择"
                android:textColor="@color/pf_amber"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/guideDevHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="进入「关于手机」连续点击版本号 7 次"
            android:textColor="@color/pf_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/guideDeviceInfo"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:text="去「关于手机」"
                android:textColor="@color/pf_volt"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/guideDevSettings"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:gravity="center"
                android:text="直达开发者选项"
                android:textColor="@color/pf_cyan"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/guideCopyMock"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_secondary_button"
            android:gravity="center"
            android:text="📋 复制「模拟位置」去设置里搜"
            android:textColor="@color/pf_cyan"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/guidePrimary"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_primary_button"
        android:gravity="center"
        android:text="刷新检测"
        android:textColor="@color/pf_canvas"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/guideFullWizard"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:text="打开完整配置向导（含常见机型口诀）"
        android:textColor="@color/pf_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_capsule"
        android:lineSpacingExtra="2dp"
        android:padding="10dp"
        android:text="本地安全承诺\n✓ 零读取通讯录/相册  ✓ 零获取设备识别码\n✓ 轨迹仅存本机  ✓ 停止即恢复真实 GPS"
        android:textColor="@color/pf_text_secondary"
        android:textSize="11sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
