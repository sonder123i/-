<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Apple 无色空间底色 -->
    <com.zcshou.gogogo.run.ui.overlay.BathymetricBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- clipToPadding=false + 底部留白：内容穿透底部玻璃导航且最后一项不被遮挡 -->
    <ScrollView
        android:id="@+id/envScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="108dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="-0.02"
                android:text="@string/checkup_title"
                android:textColor="@color/pf_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/checkup_subtitle"
                android:textColor="@color/pf_text_secondary"
                android:textSize="12sp" />

            <!-- 状态卡：先告诉用户能不能开跑，再谈细节 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_guide_hero"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:text="@string/checkup_hero_eyebrow"
                    android:textColor="@color/pf_on_primary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/checkupStatusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/checkup_ready_title"
                    android:textColor="@color/pf_on_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/checkupStatusDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.75"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/checkup_ready_desc"
                    android:textColor="@color/pf_on_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/checkupMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.6"
                    android:textColor="@color/pf_on_primary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnCheckupRecheck"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_guide_hero_button"
                    android:gravity="center"
                    android:text="@string/checkup_recheck"
                    android:textColor="@color/pf_volt"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/checkupGuideLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/checkup_guide"
                    android:textColor="@color/pf_on_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
                </LinearLayout>

                <com.zcshou.gogogo.mascot.MascotPeekView
                    android:id="@+id/checkupMascot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-64dp"
                    android:layout_marginEnd="4dp"
                    android:elevation="3dp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginStart="4dp"
                android:letterSpacing="0.06"
                android:text="@string/checkup_section_required"
                android:textColor="@color/pf_text_secondary"
                android:textSize="11sp" />

            <com.zcshou.gogogo.run.ui.glass.LiquidGlassContainer
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:elevation="0dp"
                app:lgBevelWidth="5dp"
                app:lgCaustics="false"
                app:lgCornerRadius="22dp"
                app:lgInteractive="false"
                app:lgMatte="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowDev"
                        layout="@layout/item_check_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="34dp"
                        android:background="@color/pf_stroke" />

                    <include
                        android:id="@+id/rowMock"
                        layout="@layout/item_check_row" />
                </LinearLayout>
            </com.zcshou.gogogo.run.ui.glass.LiquidGlassContainer>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="4dp"
                android:letterSpacing="0.06"
                android:text="@string/checkup_section_optional"
                android:textColor="@color/pf_text_secondary"
                android:textSize="11sp" />

            <com.zcshou.gogogo.run.ui.glass.LiquidGlassContainer
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:elevation="0dp"
                app:lgBevelWidth="5dp"
                app:lgCaustics="false"
                app:lgCornerRadius="22dp"
                app:lgInteractive="false"
                app:lgMatte="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowOverlay"
                        layout="@layout/item_check_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="34dp"
                        android:background="@color/pf_stroke" />

                    <include
                        android:id="@+id/rowBattery"
                        layout="@layout/item_check_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="34dp"
                        android:background="@color/pf_stroke" />

                    <include
                        android:id="@+id/rowWifi"
                        layout="@layout/item_check_row" />
                </LinearLayout>
            </com.zcshou.gogogo.run.ui.glass.LiquidGlassContainer>

            <!-- 安全承诺缩成一行，点击看完整说明 -->
            <LinearLayout
                android:id="@+id/checkupTrustLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@string/checkup_trust_title"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/pf_text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="@string/checkup_trust_line"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:text="@string/checkup_footnote"
                android:textColor="@color/pf_text_tertiary"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

    <!-- iOS 26 Scroll Edge Effect：体检列表滚入状态栏时渐进虚化 -->
    <com.example.liquidglass.ScrollEdgeBlurView
        android:id="@+id/topEdgeBlur"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_gravity="top"
        android:visibility="invisible" />

    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_gravity="top"
        android:alpha="0.55"
        android:background="@drawable/bg_top_scrim" />

</FrameLayout>