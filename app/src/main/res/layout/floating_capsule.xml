<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 收起态：144x38dp 磨砂药丸 -->
    <LinearLayout
        android:id="@+id/capsuleBar"
        android:layout_width="144dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_capsule"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="12dp">

        <com.zcshou.gogogo.run.ui.overlay.RingProgressView
            android:id="@+id/capsuleRing"
            android:layout_width="26dp"
            android:layout_height="26dp" />

        <TextView
            android:id="@+id/capsuleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="待命"
            android:textColor="@color/pf_text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 展开态：自动跑圈控制岛 -->
    <LinearLayout
        android:id="@+id/capsuleActions"
        android:layout_width="288dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_hub_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/hubHeader"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hubDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="@color/pf_ok"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/hubStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="模拟运行中 · 已接管"
                android:textColor="@color/pf_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnHubCollapse"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_round_dark"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/pf_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="配速"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/capsulePace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="--"
                    android:textColor="@color/pf_volt"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="圈数"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/capsuleLap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="0"
                    android:textColor="@color/pf_cyan"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCapsulePause"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:gravity="center"
                android:text="暂停"
                android:textColor="@color/pf_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCapsuleDetour"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:gravity="center"
                android:text="插点"
                android:textColor="@color/pf_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCapsuleFinish"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:gravity="center"
                android:text="收尾"
                android:textColor="@color/pf_amber"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCapsuleManual"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_secondary_button"
            android:gravity="center"
            android:text="🕹️ 临时手动接管"
            android:textColor="@color/pf_volt"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHubStopSim"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_danger_button"
            android:gravity="center"
            android:text="⏹ 结束定位并关闭"
            android:textColor="#FF5252"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 手动接管形态：紧凑战术摇杆 -->
    <LinearLayout
        android:id="@+id/capsuleRoamPanel"
        android:layout_width="210dp"
        android:layout_height="250dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_hub_panel_solid"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hubDragBar"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="≡ 拖动位置"
                android:textColor="@color/pf_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnRoamLock"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_round_dark"
                android:gravity="center"
                android:text="🔓"
                android:textColor="@color/pf_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnRoamCollapse"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_round_dark"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/pf_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hubGearWalk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="步"
                android:textColor="@color/pf_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/hubGearJog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="跑"
                android:textColor="@color/pf_volt"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hubGearBike"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="骑"
                android:textColor="@color/pf_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/hubGearCar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="车"
                android:textColor="@color/pf_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <com.zcshou.gogogo.run.ui.overlay.TacticalJoystickView
            android:id="@+id/hubJoystick"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center_horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCapsuleReturn"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:text="回归跑道"
                android:textColor="@color/pf_volt"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnHubStopSimRoam"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_danger_button"
                android:gravity="center"
                android:text="结束定位"
                android:textColor="#FF5252"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
