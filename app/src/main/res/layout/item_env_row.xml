<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="13dp"
    android:paddingEnd="12dp"
    android:paddingBottom="13dp">

    <!-- V5.0 微呼吸光学指示灯：6dp 核心点 + 22% 同心光晕 -->
    <com.zcshou.gogogo.run.ui.widget.StatusOrbView
        android:id="@+id/envDot"
        android:layout_width="15dp"
        android:layout_height="15dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/envTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pf_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/envSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/pf_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:contentDescription="进入"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/pf_text_tertiary" />
</LinearLayout>
