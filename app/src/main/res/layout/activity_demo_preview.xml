<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/demoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pf_canvas">

    <com.baidu.mapapi.map.MapView
        android:id="@+id/demoMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/demoTopScrim"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_scrim" />

    <LinearLayout
        android:id="@+id/demoTopPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="14dp"
        android:background="@drawable/bg_hub_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="模拟跑圈预览 · 无需授权"
                android:textColor="@color/pf_volt"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnDemoClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_round_dark"
                android:contentDescription="关闭"
                android:padding="9dp"
                android:src="@drawable/ic_xmark"
                app:tint="@color/pf_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/demoCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFeatureSettings="tnum"
            android:text="虚拟光点将沿 400m 跑道演示 10 秒 · 10"
            android:textColor="@color/pf_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
