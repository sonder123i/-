<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setupWizardScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hub_panel"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="30 秒完成基础配置"
                android:textColor="@color/pf_volt"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnWizardClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_round_dark"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/pf_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="只申请运行必需的 3 项能力，随时可在系统设置关闭"
            android:textColor="@color/pf_text_secondary"
            android:textSize="12sp" />

        <!-- 步骤 1：悬浮窗 -->
        <LinearLayout
            android:id="@+id/stepOverlayCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_capsule"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/stepOverlayDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="1 · 悬浮控制胶囊"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stepOverlayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未开启"
                    android:textColor="@color/pf_amber"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/stepOverlayDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="用于在跑步软件上方显示控制胶囊，方便随时暂停/接管（绝不读取屏幕内容）。"
                android:textColor="@color/pf_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/stepOverlayAction"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:text="去开启悬浮窗"
                android:textColor="@color/pf_volt"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 步骤 2：开发者选项 -->
        <LinearLayout
            android:id="@+id/stepDevCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_capsule"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/stepDevDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="2 · 开发者选项"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stepDevStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未开启"
                    android:textColor="@color/pf_amber"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/stepDevHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="连续点击版本号 7 次即可开启"
                android:textColor="@color/pf_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/stepDevAction"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:text="① 去「关于手机」连续点版本号 7 次"
                android:textColor="@color/pf_volt"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stepDevActionDirect"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_secondary_button"
                android:gravity="center"
                android:text="② 进入开发者选项（开总开关 / 选模拟位置）"
                android:textColor="@color/pf_cyan"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/stepDevManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="系统读不到开关状态？点此手动确认已开启"
                android:textColor="@color/pf_text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 步骤 3：模拟位置应用 -->
        <LinearLayout
            android:id="@+id/stepMockCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_capsule"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/stepMockDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="3 · 选择模拟位置应用"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stepMockStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未选择"
                    android:textColor="@color/pf_amber"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="开发者选项 → 选择模拟位置信息应用 → 选择「步频流」"
                android:textColor="@color/pf_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/stepMockAction"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:text="去选择模拟位置应用"
                android:textColor="@color/pf_volt"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCopyMockKeyword"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_secondary_button"
                android:gravity="center"
                android:text="📋 复制「模拟位置」去设置里搜"
                android:textColor="@color/pf_cyan"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnWizardPrimary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="下一步"
            android:textColor="@color/pf_canvas"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSandbox"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_secondary_button"
            android:gravity="center"
            android:text="先看 10 秒模拟效果演示（无需授权）"
            android:textColor="@color/pf_cyan"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_capsule"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:text="本地安全承诺\n✓ 零读取通讯录与相册    ✓ 零获取设备串号\n✓ 轨迹 100% 仅存本机    ✓ 停止即恢复真实 GPS"
            android:textColor="@color/pf_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
