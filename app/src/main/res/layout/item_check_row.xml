<?xml version="1.0" encoding="utf-8"?>
<!-- 体检检查行：状态点 + 说明 + 右侧操作 pill。已完成时 pill 变成绿色文字。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="11dp"
    android:paddingEnd="12dp"
    android:paddingBottom="11dp">

    <com.zcshou.gogogo.run.ui.widget.StatusOrbView
        android:id="@+id/envDot"
        android:layout_width="15dp"
        android:layout_height="15dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/envTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pf_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/envSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/pf_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/envAction"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_secondary_button"
        android:gravity="center"
        android:minWidth="68dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/pf_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>